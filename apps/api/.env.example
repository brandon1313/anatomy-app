DATABASE_URL=postgresql://anatomia:anatomia@localhost:5433/anatomia
PORT=3000
# Genera uno con: openssl rand -base64 48
JWT_SECRETO=cambia-esto
JWT_ACCESO_MINUTOS=15
JWT_RENOVACION_DIAS=30
# Orígenes permitidos para CORS (panel), separados por coma
CORS_ORIGENES=http://localhost:5174,http://localhost:8081
# Proveedor del generador: anthropic | ejemplo (devuelve el ejemplo del contrato, sin llamar a ningún LLM)
LLM_PROVEEDOR=anthropic
LLM_MODELO=claude-opus-5-5
# Si no se define, el SDK usa el perfil de `ant auth login`. Una variable vacía lo taparía.
# ANTHROPIC_API_KEY=
